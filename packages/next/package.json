{
  "name": "@kalshi-kit/next",
  "version": "0.1.0",
  "description": "One-line Next.js helper that proxies Kalshi API requests through your app",
  "license": "MIT",
  "author": "Sam <sam.shridhar1950f@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-shridhar1950f/kalshi-kit.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/sam-shridhar1950f/kalshi-kit#readme",
  "bugs": "https://github.com/sam-shridhar1950f/kalshi-kit/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "kalshi",
    "prediction-markets",
    "next",
    "nextjs",
    "proxy"
  ]
}
